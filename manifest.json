{
  "manifest_version": 3,
  "name": "ChatGPT Embedded Panel",
  "version": "1.0.0",
  "key": "",
  "description": "Runs the signed-in ChatGPT Web UI in a Chrome Side Panel and lets the current ordinary webpage become a task's locked Browser WebMCP target.",
  "permissions": [
    "scripting",
    "nativeMessaging",
    "sidePanel",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open ChatGPT Panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "embedded-chatgpt.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "model-probe.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://chatgpt.com;"
  }
}
